# Copy this file to .env and fill in real values for your environment.
# .env itself is gitignored — never commit real secrets.

# Only needed for wakedonalds.settings.production (i.e. once deployed)
SECRET_KEY=replace-with-a-real-django-secret-key
DEBUG=False
ALLOWED_HOSTS=your-eb-environment.elasticbeanstalk.com

DB_NAME=wakedonalds
DB_USER=admin
DB_PASSWORD=replace-me
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sending-address@gmail.com
EMAIL_HOST_PASSWORD=replace-me
